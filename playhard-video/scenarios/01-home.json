{
  "_comment": "Ролик 1 — главная unitodi.ru: загрузка и прелоадер → первый экран → меню → «Программное обеспечение» (подменю, наведение на пункты) → скролл главной.",
  "url": "https://unitodi.ru/",
  "viewport": { "width": 1440, "height": 810 },
  "scale": "auto",
  "fps": 60,
  "scrollMode": "wheel",
  "maxDuration": 45,
  "mouseStart": [1010, 600],
  "hide": [".cookie-consent"],
  "steps": [
    { "do": "goto" },
    { "do": "waitFor", "preloader": true, "timeout": 25 },
    { "do": "wait", "sec": 1.4 },

    { "do": "move", "to": "selector:.hml-item__text[href='/about/']", "dur": 1.0 },
    { "do": "wait", "sec": 0.45 },
    { "do": "move", "to": "selector:.hml-item__text[href='/vacancies/']" },
    { "do": "wait", "sec": 0.45 },
    { "do": "move", "to": "selector:.hml-item__text[href='/contacts/']" },
    { "do": "wait", "sec": 0.45 },
    { "do": "move", "to": "selector:[data-modal-open='hs-terminals']" },
    { "do": "wait", "sec": 0.5 },
    { "do": "move", "to": "selector:[data-modal-open='hs-software']" },
    { "do": "wait", "sec": 0.6 },
    { "do": "click" },
    { "do": "wait", "sec": 0.9 },

    { "do": "move", "to": "text:uniTodi Pay App", "offset": [-60, 0], "dur": 0.7 },
    { "do": "wait", "sec": 0.75 },
    { "do": "move", "to": "text:uniTodi RKL", "offset": [-60, 0] },
    { "do": "wait", "sec": 0.75 },
    { "do": "move", "to": "text:uniTodi TMS", "offset": [-60, 0] },
    { "do": "wait", "sec": 0.75 },
    { "do": "move", "to": "text:uniTodi Soft POS", "offset": [-60, 0] },
    { "do": "wait", "sec": 1.0 },
    { "do": "key", "key": "Escape" },
    { "do": "wait", "sec": 0.2 },
    { "do": "move", "to": [900, 560], "dur": 1.0 },
    { "do": "wait", "sec": 0.4 },

    { "do": "tour", "speed": 900, "dwell": 0.8, "maxDur": 2.2, "until": 6200 },
    { "do": "wait", "sec": 0.6 }
  ],
  "compose": {
    "_comment": "Пока нет подложки Сабрины — чистый экран 16:9 в 2400x1350. С подложкой: bg, size 1200x600, rect x,y,w,h, radius.",
    "size": "1200x675",
    "scale": 2,
    "cursor": true
  }
}

{
  "_comment": "Ролик 1 — главная, ~30 с: загрузка и прелоадер → первый экран → меню → «Программное обеспечение» (подменю, наведение на пункты) → скролл главной.",
  "url": "https://unitodi.ru/",
  "viewport": { "width": 1440, "height": 810 },
  "scale": "auto",
  "scrollMode": "wheel",
  "maxDuration": 45,
  "mouseStart": [1010, 600],
  "hide": [".cookie-consent"],
  "steps": [
    { "do": "goto" },
    { "do": "waitFor", "preloader": true, "timeout": 25 },
    { "do": "wait", "sec": 1.0 },
    { "do": "move", "to": "selector:.hml-item__text[href='/about/']", "dur": 0.9 },
    { "do": "wait", "sec": 0.35 },
    { "do": "move", "to": "selector:.hml-item__text[href='/vacancies/']" },
    { "do": "wait", "sec": 0.35 },
    { "do": "move", "to": "selector:.hml-item__text[href='/contacts/']" },
    { "do": "wait", "sec": 0.35 },
    { "do": "move", "to": "selector:[data-modal-open='hs-terminals']" },
    { "do": "wait", "sec": 0.4 },
    { "do": "move", "to": "selector:[data-modal-open='hs-software']" },
    { "do": "wait", "sec": 0.5 },
    { "do": "click" },
    { "do": "wait", "sec": 0.8 },
    { "do": "move", "to": "text:uniTodi Pay App", "offset": [-60, 0], "dur": 0.7 },
    { "do": "wait", "sec": 0.6 },
    { "do": "move", "to": "text:uniTodi RKL", "offset": [-60, 0] },
    { "do": "wait", "sec": 0.6 },
    { "do": "move", "to": "text:uniTodi TMS", "offset": [-60, 0] },
    { "do": "wait", "sec": 0.6 },
    { "do": "move", "to": "text:uniTodi Soft POS", "offset": [-60, 0] },
    { "do": "wait", "sec": 0.8 },
    { "do": "key", "key": "Escape" },
    { "do": "wait", "sec": 0.2 },
    { "do": "move", "to": [900, 560], "dur": 0.8 },
    { "do": "wait", "sec": 0.2 },
    { "do": "tour", "speed": 1000, "dwell": 0.6, "maxDur": 2.0, "until": 5400 },
    { "do": "wait", "sec": 0.5 }
  ],
  "compose": { "cursor": true }
}
